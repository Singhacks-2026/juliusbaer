# Copy to .env and fill in — .env is git-ignored, never commit a real key.
# The Phase 2 explainer and pre-generation script read these from the environment.

# Your Anthropic API key (get one at console.anthropic.com). Required only for
# live grounded explanations; without it the app uses deterministic fallbacks.
ANTHROPIC_API_KEY=

# Optional overrides:
# WI_MODEL=claude-opus-5      # model for explanations
# WI_EFFORT=medium            # low | medium | high | xhigh | max
# WI_CACHE_DIR=.wi_cache      # where cached explanations live
